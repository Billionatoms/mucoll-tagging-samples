# Site: CERN lxplus / HTCondor, EOS over xrootd. Sourced by scripts/common.sh.
# Personal overrides go in config/site.local.env (git-ignored).
#
# Inputs are staged to the job's scratch with xrdcp and outputs are copied back
# with xrdcp, so worker nodes never read or write /eos through FUSE.
# The repo (and install/lctuple) must be on AFS so the workers can see it.

IMAGE="${IMAGE:-/eos/experiment/muoncollider/software/MuonC_MuSICv2_v5_dev.sif}"

DATA_ROOT="${DATA_ROOT:-root://eosexperiment.cern.ch//eos/experiment/muoncollider/data/EUS/samples/MuSIC_v2/JETtagging}"
OUT_ROOT="${OUT_ROOT:-root://eosuser.cern.ch//eos/user/${USER:0:1}/$USER/mucoll-tagging-samples}"
RECO_ROOT="${RECO_ROOT:-$OUT_ROOT}"

BINDS="${BINDS:-/afs /cvmfs}"

SCRATCH_ROOT="${SCRATCH_ROOT:-${_CONDOR_SCRATCH_DIR:-${TMPDIR:-/tmp}}}"
