# Site: a workstation with the samples synced under ~/cernbox.
# Sourced by scripts/common.sh. Personal overrides go in config/site.local.env (git-ignored).

IMAGE="${IMAGE:-$HOME/cernbox/MuCol_software_framework/MuonC_MuSICv2_v5_dev.sif}"

# <root>/<sample>/<mass>/sim/sim_<q>_<mass>_<NNNNN>.slcio
DATA_ROOT="${DATA_ROOT:-$HOME/cernbox/MuSIC_v2_10TeV_samples}"
# Reco input for --mode ntuple: <root>/<sample>/<mass>/recoSig/reco_<q>_<mass>_<NNNNN>.slcio
RECO_ROOT="${RECO_ROOT:-$DATA_ROOT}"
# Outputs: <root>/<sample>/<mass>/{recoSig,<NTUPLE_SUBDIR>}/
OUT_ROOT="${OUT_ROOT:-$HOME/mucoll-tagging-output}"

# Host paths to bind into the container (space separated). The repo, the job work
# directory and local input/output directories are bound automatically.
BINDS="${BINDS:-$HOME/cernbox}"

SCRATCH_ROOT="${SCRATCH_ROOT:-${TMPDIR:-/tmp}}"
