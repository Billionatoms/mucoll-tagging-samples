# Site: Artemis (Slurm, Lustre scratch). Sourced by scripts/common.sh.
# Personal overrides go in config/site.local.env (git-ignored).

IMAGE="${IMAGE:-/mnt/epp/$USER/MuColl/MuonC_MuSICv2_v5_dev.sif}"

DATA_ROOT="${DATA_ROOT:-/mnt/lustre/scratch/epp/$USER/new_mucoll_samples}"
RECO_ROOT="${RECO_ROOT:-$DATA_ROOT}"
OUT_ROOT="${OUT_ROOT:-$DATA_ROOT}"

BINDS="${BINDS:-/mnt/lustre /mnt/epp/$USER /run}"

SCRATCH_ROOT="${SCRATCH_ROOT:-${TMPDIR:-/tmp}}"

# Event generation (generation/run_gen.sh): the eventgen image, converted to SIF,
# and the SMEFTsim UFO used by tc_signal (checked against
# generation/processes/tc_signal/ufo.sha256). The generated samples live under
# $DATA_ROOT/s-channel/{dijets/{bb,cc,qq}_dijets,mumutc}/{gen,sim,reco,ntuples}
# (GEN_SAMPLE_DIRS in scripts/common.sh); GEN_ROOT only moves gen/.
GEN_IMAGE="${GEN_IMAGE:-/its/home/$USER/MuColl/eventgen.sif}"
TC_UFO="${TC_UFO:-/its/home/$USER/MuColl/tqllmumucollidermcgen/SMEFTsim_general_MwScheme_UFO}"
GEN_ROOT="${GEN_ROOT:-$DATA_ROOT}"
