# Job settings for tc_signal (sourced by generation/run_gen.sh and scripts/run_sim.sh).
EVENTS_PER_JOB=10000       # one generator job, one HepMC3 file
SIM_EVENTS=25              # events per ddsim job
GEN_SEED_BASE=41000000     # generator job j uses seed GEN_SEED_BASE + j
SIM_SEED_BASE=42000000     # sim job i uses seed SIM_SEED_BASE + i

# The model: the site's TC_UFO directory, checked against ufo.sha256, copied into
# the job, and given a restriction derived from UFO_RESTRICT_BASE in which the
# coefficient UFO_COEFF_ID is set to 9.999999e-01. Upstream restrictions treat a
# value of exactly 1 as "fixed", which would remove the coefficient.
UFO_RESTRICT_BASE=restrict_lequ1LH_ctmumu.dat
UFO_COEFF_ID=1205          # clequ1Re2232
