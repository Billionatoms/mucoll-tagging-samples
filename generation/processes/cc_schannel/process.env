# Job settings for cc_schannel (sourced by generation/run_gen.sh and scripts/run_sim.sh).
EVENTS_PER_JOB=10000       # events per generator job (one HepMC3 file); a multiple of SIM_EVENTS
SIM_EVENTS=25              # events per ddsim job, as in the official samples
GEN_SEED_BASE=21000000     # generator job j uses seed GEN_SEED_BASE + j
SIM_SEED_BASE=22000000     # sim job i uses seed SIM_SEED_BASE + i
